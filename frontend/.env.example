# =================================================================
# ETRAI Frontend Environment Configuration Template
# =================================================================
# In development, Vite proxies /api to http://localhost:5000 automatically.
# In production, set VITE_API_BASE_URL to your backend API domain or leave
# empty if frontend and backend are served on the same origin.
# =================================================================

# Backend API base URL (Optional: leave empty for same-origin proxy)
VITE_API_BASE_URL=http://localhost:5000
