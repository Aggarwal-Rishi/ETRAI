# ============================================================
# ETRAI Backend — Environment Variables for Railway Deployment
# ============================================================
# Copy these into Railway > Project > Variables

PORT=5000
NODE_ENV=production

# PostgreSQL (Neon) — replace with your Neon connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — use a strong random string in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
# e.g. https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=https://your-app.vercel.app

# AI & Search API Keys (Sole AI Provider: Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
SERPER_API_KEY=your_serper_api_key_here
