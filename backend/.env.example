# =================================================================
# ETRAI Backend Production Environment Configuration Template
# =================================================================
# Copy this file to .env and replace placeholder values with your
# actual production keys and connection strings.
# NEVER commit raw keys or secrets to version control.
# =================================================================

# HTTP Server
PORT=5000
NODE_ENV=production

# Database (SQLite default for single-node; PostgreSQL URI for multi-node)
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Agent 2 Claim Extraction (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Agent 3 Web Retrieval (Serper Search API)
SERPER_API_KEY=your_serper_api_key_here

# OpenAI API Key (Optional fallback for auxiliary services)
OPENAI_API_KEY=your_openai_api_key_here
