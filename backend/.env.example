# ============================================================
# ETRAI Backend — Environment Variables Configuration
# ============================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Database (Neon / Supabase / Local PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Google Gemini AI Provider Configuration (No Hardcoded Credentials)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
GEMINI_BACKOFF_FACTOR_MS=1000

# Serper Google Web Search API
SERPER_API_KEY=your_serper_api_key_here

# System & Rate Limiting Thresholds
MAX_CONCURRENT_JOBS=10
MAX_SEARCH_QUERIES_PER_CLAIM=4
PIPELINE_TIMEOUT_MS=120000
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_GENERAL_RPM=150
RATE_LIMIT_AUTH_RPM=30
RATE_LIMIT_VERIFY_RPM=25
