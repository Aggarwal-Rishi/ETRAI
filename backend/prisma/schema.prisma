// Prisma Schema for ETRAI Fact-Checking & Verification Platform

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. AUTHENTICATION, WORKSPACES & TEAM MODELS
// -------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String?
  phone        String?
  company      String?
  role         String        @default("OWNER") // OWNER | CREATOR | REVIEWER | READER
  photoUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  analyses     Analysis[]
  workspaces   Workspace[]   @relation("WorkspaceOwner")
  memberships  TeamMember[]
  sessions     Session[]
  usageRecords UsageRecord[]

  @@map("users")
}

model Workspace {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  ownerId            String
  owner              User                @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  plan               String              @default("Team") // Starter | Team | Newsroom | Enterprise
  maxSeats           Int                 @default(5)
  verificationLimit  Int                 @default(500)
  verificationsUsed  Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  members            TeamMember[]
  invitations        Invitation[]
  analyses           Analysis[]
  settings           WorkspaceSettings?
  customSources      Source[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  usageRecords       UsageRecord[]
  newsItems          NewsItem[]
  narrativeClusters  NarrativeCluster[]

  @@index([ownerId])
  @@map("workspaces")
}

model TeamMember {
  id           String     @id @default(uuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  name         String?
  phone        String?
  company      String?
  role         String     @default("REVIEWER") // OWNER | CREATOR | REVIEWER | READER
  status       String     @default("ACTIVE")   // ACTIVE | INVITED | DISABLED
  photoUrl     String?
  color        String     @default("#0B5CD5")
  lastActive   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([email])
  @@map("team_members")
}

model Invitation {
  id           String     @id @default(uuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         String     @default("REVIEWER")
  token        String     @unique
  status       String     @default("PENDING") // PENDING | ACCEPTED | EXPIRED | CANCELLED
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([workspaceId])
  @@index([token])
  @@map("invitations")
}

model Session {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String     @unique
  ipAddress    String?
  userAgent    String?
  isActive     Boolean    @default(true)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// -------------------------------------------------------------
// 2. SUBSCRIPTIONS & BILLING RECORDS
// -------------------------------------------------------------

model Subscription {
  id                   String     @id @default(uuid())
  workspaceId          String
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 String     @default("Team") // Starter | Team | Newsroom | Enterprise
  cycle                String     @default("MONTHLY") // MONTHLY | ANNUAL
  seats                Int        @default(5)
  status               String     @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED
  currentPeriodStart   DateTime   @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  paymentMethodType    String?    // UPI | CARD | NET_BANKING | INVOICE
  paymentMethodDetails String?    // Stored as JSON string
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([workspaceId])
  @@map("subscriptions")
}

model Invoice {
  id            String     @id @default(uuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceNumber String     @unique
  amount        Float
  currency      String     @default("INR")
  taxAmount     Float      @default(0)
  status        String     @default("PAID") // PAID | PENDING | FAILED
  periodStart   DateTime
  periodEnd     DateTime
  pdfUrl        String?
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime   @default(now())

  @@index([workspaceId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model UsageRecord {
  id             String     @id @default(uuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId     String?
  tokensConsumed Int        @default(0)
  costUsd        Float      @default(0.0)
  runType        String     @default("VERIFICATION") // VERIFICATION | RE_VERIFY | FETCH
  createdAt      DateTime   @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@map("usage_records")
}

// -------------------------------------------------------------
// 3. WORKSPACE SETTINGS & RANKED SOURCES
// -------------------------------------------------------------

model WorkspaceSettings {
  id                 String     @id @default(uuid())
  workspaceId        String     @unique
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scoringWeightsJson String?    // Stored as JSON string
  thresholdsJson     String?    // Stored as JSON string
  alertsJson         String?    // Stored as JSON string
  regionFocus        String     @default("India")
  primaryBeat        String     @default("Policy & governance")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("workspace_settings")
}

model Source {
  id                 String     @id @default(uuid())
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  domain             String
  rank               Int        @default(2) // 1 to 4
  authorityScore     Float      @default(80.0)
  reliabilityScore   Float      @default(85.0)
  sourceType         String     @default("PRIMARY_NEWSROOM") // OFFICIAL_GAZETTE | GLOBAL_WIRE | PRIMARY_NEWSROOM | SPECIALIZED_DESK | FACT_CHECK_DESK | SOCIAL_MEDIA | GENERAL_WEB
  sourceRole         String     @default("PRIMARY_REPORTING") // PRIMARY_AUTHORITY | PRIMARY_REPORTING | SECONDARY_REPORTING | FACT_CHECKER | SPECIALIST | PROVENANCE_SOURCE | SIGNAL_ONLY | SPREAD_TRACKING | WATCHLIST
  purpose            String?
  status             String     @default("ACTIVE") // ACTIVE | DISABLED | FLAGGED | WATCHLIST
  isCustom           Boolean    @default(false)
  verifiedCount      Int        @default(0)
  refutedCount       Int        @default(0)
  correctionCount    Int        @default(0)
  parentCompany      String?
  syndicationGroup   String?
  lastEvaluatedAt    DateTime?  @default(now())
  metadataJson       String?    // JSON stringified metadata
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([workspaceId])
  @@index([domain])
  @@index([sourceRole])
  @@index([status])
  @@map("sources")
}

// -------------------------------------------------------------
// 4. VERIFICATION RUNS, CLAIMS & EVIDENCE MODELS
// -------------------------------------------------------------

model Analysis {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title          String
  inputType      String
  inputSource    String
  selectedTypes  String
  status         String          @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  summary        String?
  overallMetrics String?         // Stored as JSON stringified string
  reportData     String?         // Stored as JSON stringified string
  errorMessage   String?
  truncated      Boolean         @default(false)
  runVersion     Int             @default(1)
  tokensConsumed Int             @default(0)
  costUsd        Float           @default(0.0)
  trustScore     Float?
  verdict        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  mediaAnalysis  MediaAnalysis?
  claims         Claim[]
  entities       NamedEntity[]
  numericalFacts NumericalFact[]
  provenance     ProvenanceEvent[]
  provenanceNodes ProvenanceNode[]
  spreadClusters SpreadCluster[]
  quoteAttributions QuoteAttribution[]
  reportSections ReportSection[]

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("analyses")
}

model Claim {
  id                   String         @id @default(uuid())
  analysisId           String
  analysis             Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  claimText            String
  normalizedClaim      String?
  claimType            String         @default("FACTUAL_STATEMENT") // QUANTITATIVE | TEMPORAL | EVENT | ATTRIBUTION | INSTITUTIONAL | LEGAL | FINANCIAL | DOCUMENTARY | GEOGRAPHIC | SCIENTIFIC | HISTORICAL | FACTUAL_STATEMENT
  claimScope           String         @default("National") // International | National | Regional | Local
  category             String         @default("Factual Statement")
  verdict              String         @default("INSUFFICIENT_EVIDENCE") // SUPPORTED | FALSE | MISLEADING | PARTIALLY_TRUE | OUTDATED | UNSUPPORTED | INSUFFICIENT_EVIDENCE | DISPUTED
  status               String         @default("SUSPICIOUS") // TRUSTED | PARTIALLY_VERIFIED | SUSPICIOUS | FABRICATED
  confidence           Float          @default(50.0)
  importanceScore      Float          @default(70.0)
  extractionConfidence Float          @default(90.0)
  verifiability        String         @default("DIRECTLY_VERIFIABLE") // DIRECTLY_VERIFIABLE | CONTEXT_DEPENDENT | SPECULATIVE | UNVERIFIABLE
  attribution          String?
  temporalContext      String?
  entitiesJson         String?        // JSON array of strings
  datesJson            String?        // JSON array of strings
  numbersJson          String?        // JSON array of strings
  locationsJson        String?        // JSON array of strings
  reasoning            String?
  hasCorrection        Boolean        @default(false)
  correctedClaim       String?
  correctionBasis      String?
  partiallyAccurate    Boolean        @default(false)
  rawJson              String?        // Full claim JSON
  createdAt            DateTime       @default(now())

  evidenceItems        EvidenceItem[]
  entityConnections    EntityClaimConnection[]
  quoteAttributions    QuoteAttribution[]

  @@index([analysisId])
  @@index([verdict])
  @@index([claimType])
  @@map("claims")
}

model EvidenceItem {
  id                    String   @id @default(uuid())
  claimId               String
  claim                 Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceId              String?
  sourceIndex           Int      @default(0)
  url                   String
  domain                String
  title                 String
  snippet               String?
  content               String?
  excerpt               String?
  surroundingContext    String?
  stance                String   @default("NEUTRAL") // SUPPORTS | REFUTES | NEUTRAL | IRRELEVANT
  relationship          String   @default("NEUTRAL") // SUPPORTS | CONTRADICTS | QUALIFIES | IRRELEVANT | INSUFFICIENT
  evidenceType          String   @default("PRIMARY_REPORTING") // PRIMARY_DOCUMENT | OFFICIAL_STATEMENT | FACT_CHECK_DEBUNK | PEER_REVIEWED_STUDY | EYEWITNESS_REPORT | SECONDARY_ANALYSIS | SOCIAL_POST
  relevanceScore        Float    @default(50.0)
  reliabilityContribution Float  @default(80.0)
  independenceGroup     String?
  isIndependent         Boolean  @default(true)
  isSyndicatedDuplicate Boolean  @default(false)
  authorityRank         Int      @default(2)
  authorityScore        Float    @default(80.0)
  freshness             String   @default("CURRENT_WEEK") // BREAKING_NOW | RECENT_24H | CURRENT_WEEK | ARCHIVE | OUTDATED
  retrievalStatus       String   @default("SUCCESS") // SUCCESS | PARTIAL | FAILED | BLOCKED
  retrievedAt           DateTime @default(now())
  publishedAt           DateTime?
  reason                String?
  createdAt             DateTime @default(now())

  @@index([claimId])
  @@index([domain])
  @@index([relationship])
  @@map("evidence_items")
}

model NamedEntity {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  type        String   @default("PERSON") // PERSON | ORGANIZATION | GOVERNMENT_BODY | COMPANY | PRODUCT | LOCATION | EVENT | DOCUMENT
  status      String   @default("UNVERIFIED") // VERIFIED | SUSPICIOUS | FABRICATED | UNVERIFIED
  finding     String?
  confidence  Float    @default(80.0)
  mentionsCount Int    @default(1)
  metadataJson String?
  createdAt   DateTime @default(now())

  claimConnections EntityClaimConnection[]

  @@index([analysisId])
  @@index([type])
  @@map("named_entities")
}

model EntityClaimConnection {
  id         String      @id @default(uuid())
  entityId   String
  entity     NamedEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  claimId    String
  claim      Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  roleInClaim String     @default("SUBJECT") // SUBJECT | OBJECT | QUOTED_SPEAKER | TARGET | JURISDICTION | EVIDENCE_ANCHOR
  confidence Float       @default(85.0)
  createdAt  DateTime    @default(now())

  @@unique([entityId, claimId])
  @@index([entityId])
  @@index([claimId])
  @@map("entity_claim_connections")
}

model QuoteAttribution {
  id                 String   @id @default(uuid())
  analysisId         String
  analysis           Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  claimId            String?
  claim              Claim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  quoteText          String
  claimedSpeaker     String?
  claimedAffiliation String?
  verificationStatus String   @default("UNATTRIBUTED_ASSERTION") // VERIFIED_ATTRIBUTION | UNVERIFIED_ATTRIBUTION | MISATTRIBUTED | UNATTRIBUTED_ASSERTION | FABRICATED_QUOTE
  isAltered          Boolean  @default(false)
  alterationDetails  String?
  isAuthoritative    Boolean  @default(false)
  confidence         Float    @default(50.0)
  originalSourceUrl  String?
  originalContext    String?
  createdAt          DateTime @default(now())

  @@index([analysisId])
  @@index([claimId])
  @@index([verificationStatus])
  @@map("quote_attributions")
}

model ProvenanceNode {
  id                     String   @id @default(uuid())
  analysisId             String
  analysis               Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  url                    String?
  domain                 String
  publishedAt            DateTime?
  discoveredAt           DateTime @default(now())
  contentHash            String?
  mediaHash              String?
  sourceRelationship     String   @default("REPOST") // ORIGINAL | SOURCE | REPOST | ARTICLE | SOCIAL_POST | CURRENT_INPUT | OFFICIAL_DEBUNK
  nodeType               String   @default("ARTICLE") // ORIGINAL | SOURCE | REPOST | ARTICLE | SOCIAL_POST | CURRENT_INPUT
  confidence             Float    @default(50.0)
  isFirstKnownAppearance Boolean  @default(false)
  sequenceOrder          Int      @default(0)
  title                  String?
  publisher              String?
  metadataJson           String?
  createdAt              DateTime @default(now())

  outgoingEdges          ProvenanceEdge[] @relation("SourceNode")
  incomingEdges          ProvenanceEdge[] @relation("TargetNode")

  @@index([analysisId])
  @@index([domain])
  @@index([sourceRelationship])
  @@index([isFirstKnownAppearance])
  @@map("provenance_nodes")
}

model ProvenanceEdge {
  id               String         @id @default(uuid())
  fromNodeId       String
  fromNode         ProvenanceNode @relation("SourceNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId         String
  toNode           ProvenanceNode @relation("TargetNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  relationshipType String         @default("PROPAGATION") // SYNDICATION | REPOST | DERIVATIVE | QUOTE_ATTRIBUTION | AMPLIFICATION | MODIFICATION
  timeDeltaHours   Float?
  confidence       Float          @default(70.0)
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("provenance_edges")
}

model SpreadCluster {
  id                     String   @id @default(uuid())
  analysisId             String
  analysis               Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  clusterName            String
  clusterType            String   @default("SYNDICATION") // SYNDICATION | SOCIAL_VIRAL | NEWSROOM_NETWORK | COORDINATED_REPOSTING
  repostCount            Int      @default(1)
  domainCount            Int      @default(1)
  velocityLabel          String?
  coordinationConfidence Float    @default(0.0) // 0-100
  coordinationPattern    String   @default("UNSUPPORTED") // HIGH | MEDIUM | LOW | UNSUPPORTED
  evidenceRationale      String?
  domainsJson            String?  // Stored JSON array of domains
  timelineJson           String?  // Stored JSON array of propagation points
  createdAt              DateTime @default(now())

  @@index([analysisId])
  @@index([clusterType])
  @@map("spread_clusters")
}

model NumericalFact {
  id            String   @id @default(uuid())
  analysisId    String
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  asPrinted     String
  refersTo      String
  actualFinding String
  status        String   @default("UNVERIFIED") // VERIFIED | SUSPICIOUS | FABRICATED
  createdAt     DateTime @default(now())

  @@index([analysisId])
  @@map("numerical_facts")
}

model ProvenanceEvent {
  id            String   @id @default(uuid())
  analysisId    String
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  timeLabel     String
  platform      String
  description   String
  status        String   @default("UNVERIFIED") // VERIFIED | SUSPICIOUS | FABRICATED | UNVERIFIED
  sequenceIndex Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([analysisId])
  @@map("provenance_events")
}

model ReportSection {
  id           String   @id @default(uuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  sectionKey   String   // HIGHLIGHTS | SCORE_DERIVATION | MEDIA_FORENSICS | SOURCES | INTENT | PROVENANCE | RELATED
  sectionTitle String
  contentJson  String   // JSON stringified section data
  createdAt    DateTime @default(now())

  @@index([analysisId])
  @@index([sectionKey])
  @@map("report_sections")
}

model MediaAnalysis {
  id                      String   @id @default(uuid())
  analysisId              String   @unique
  analysis                Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  mediaType               String
  filename                String
  mimeType                String
  sizeBytes               Int
  sha256                  String
  width                   Int?
  height                  Int?
  duration                Float?
  fps                     Float?
  codec                   String?
  metadataJson            String?  // Stored as JSON stringified string
  ocrText                 String?
  transcriptJson          String?  // Stored as JSON stringified string
  visualFindingsJson      String?  // Stored as JSON stringified string
  manipulationSignalsJson String?  // Stored as JSON stringified string
  perceptualHash          String?
  forensicVerdict         String?  @default("NO_MANIPULATION_SIGNAL_FOUND")
  forensicConfidence      Float?   @default(85.0)
  c2paJson                String?
  documentForensicsJson   String?
  audioAnalysisJson       String?
  ocrBlocksJson           String?
  reverseSearchJson       String?  // Stored as JSON stringified string
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("media_analyses")
}

// -------------------------------------------------------------
// 5. NEWS FEED & NARRATIVE CLUSTERS
// -------------------------------------------------------------

model NewsItem {
  id              String            @id @default(uuid())
  workspaceId     String?
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  url             String?
  sourceName      String
  domain          String
  category        String
  mediaType       String            @default("Text") // Image | Video | PDF | Text
  publishedAt     DateTime          @default(now())
  timeAgoLabel    String?
  status          String            @default("UNVERIFIED") // VERIFIED | SUSPICIOUS | FABRICATED | UNVERIFIED
  trustScore      Float?
  isHero          Boolean           @default(false)
  isLead          Boolean           @default(false)
  isClusterActive Boolean           @default(false)
  clusterId       String?
  cluster         NarrativeCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  rawJson         String?
  createdAt       DateTime          @default(now())

  @@index([workspaceId])
  @@index([clusterId])
  @@index([publishedAt])
  @@map("news_items")
}

model NarrativeCluster {
  id             String     @id @default(uuid())
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  velocityLabel  String?    // e.g. +412% · 38 posts
  postCount      Int        @default(1)
  domainsCount   Int        @default(1)
  status         String     @default("ACTIVE") // ACTIVE | RESOLVED
  firstSeenAt    DateTime   @default(now())
  leadAnalysisId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  newsItems      NewsItem[]

  @@index([workspaceId])
  @@map("narrative_clusters")
}
