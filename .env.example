# =================================================================
# ETRAI — Evidence-first Truth & Reliability AI
# Production & Staging Environment Configuration Reference
# =================================================================

# -----------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5000

# -----------------------------------------------------------------
# 2. Database Connection
# Single-Instance (Default): SQLite with WAL Mode
# DATABASE_URL="file:./dev.db"
#
# Clustered / Scaled Production: PostgreSQL
# DATABASE_URL="postgresql://etrai_user:StrongPasswordHere@postgres-host:5432/etrai_prod?schema=public"
# -----------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------
# 3. Authentication & Security Secrets
# Minimum 32-character high-entropy secret for JWT signing
# -----------------------------------------------------------------
JWT_SECRET=your_production_secure_jwt_secret_min_32_chars_long_random_hex
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------
# 4. Primary AI & Extraction Engine (Google Gemini)
# Required for Agent 2 Claim Extraction (REAL_LLM mode)
# -----------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourProductionGeminiApiKeyHere
GEMINI_MODEL=gemini-flash-lite-latest

# -----------------------------------------------------------------
# 5. Live Search & Retrieval Engine (Serper Google Search API)
# Required for Agent 3 Multi-Source Verification
# -----------------------------------------------------------------
SERPER_API_KEY=your_serper_google_search_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# -----------------------------------------------------------------
# 6. Auxiliary & Fallback AI (Optional)
# -----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-optional_openai_key_here

# -----------------------------------------------------------------
# 7. Cost & Resource Safety Controls
# -----------------------------------------------------------------
MAX_CONCURRENT_JOBS=10
MAX_SEARCH_QUERIES_PER_CLAIM=4
PIPELINE_TIMEOUT_MS=120000
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_GENERAL_RPM=150
RATE_LIMIT_AUTH_RPM=30
RATE_LIMIT_VERIFY_RPM=25
